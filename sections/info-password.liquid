{%- liquid
  assign s = section.settings
-%}
<div class="soon" id="soon">
  {% render 'ms-image', image: s.bg_image, fallback: 'hero-bg.webp', alt: '', width: 2200, height: 1228, class: 'soon__bg', loading: 'eager', attrs: 'aria-hidden="true"' %}
  {% render 'ms-image', image: s.product_image, fallback: 'hero.webp', alt: s.product_alt, width: 2400, height: 1728, class: 'soon__product', loading: 'eager', attrs: 'fetchpriority="high"' %}
  <div class="soon__copy">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 260 | image_tag: class: 'soon__logo', width: 129, height: 54, alt: shop.name }}
    {%- else -%}
      <img class="soon__logo" src="{{ 'logo.svg' | asset_url }}" width="129" height="54" alt="{{ shop.name | escape }}">
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<p class="soon__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="soon__title">{{ s.title | escape | newline_to_br }}</h1>
    {%- if s.lede != blank -%}<p class="soon__lede">{{ s.lede }}</p>{%- endif -%}
    {%- if s.show_signup -%}
      {% render 'signup-form', id: 'password-signup', class: 'signup__form soon__form', button_label: s.button_label, placeholder: s.placeholder, consent_text: s.consent_text, success_text: s.success_text %}
    {%- endif -%}
    <details class="soon__pass" data-pass-toggle>
      <summary>{{ s.pass_toggle }}</summary>
      {%- form 'storefront_password', class: 'soon__pass-form', id: 'soon-pass-form' -%}
        <label class="sr-only" for="soon-pass">{{ s.pass_label }}</label>
        <input id="soon-pass" name="password" type="password" placeholder="{{ s.pass_placeholder | escape }}" autocomplete="current-password"{% if form.errors %} aria-invalid="true" aria-describedby="soon-pass-error"{% endif %} required>
        <button class="btn btn--ghost-light btn--sm" type="submit">{{ s.pass_button }}</button>
        {%- if form.errors -%}
          <p class="form-msg is-error" id="soon-pass-error" role="alert" data-pass-error>{{ s.pass_error }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bg_image", "label": "Background" },
    { "type": "image_picker", "id": "product_image", "label": "Product photo" },
    { "type": "text", "id": "product_alt", "label": "Product photo alt text", "default": "Bonfire and Yoga Studio incense boxes on driftwood beside a burning stick" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave blank for the white Mr. Sniff's logo." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Incense sticks and holders" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Lighting up\nDecember 15." },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "Two scents made of nothing but wood. Get on the list and you'll be the first to get a whiff." },
    { "type": "header", "content": "Email sign-up" },
    { "type": "checkbox", "id": "show_signup", "label": "Show sign-up form", "default": true },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "consent_text", "label": "Consent text", "default": "Yes, email me when Mr. Sniff's launches. Unsubscribe anytime." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in. First whiff is yours." },
    { "type": "header", "content": "Store password" },
    { "type": "text", "id": "pass_toggle", "label": "Toggle label", "default": "Have the store password?" },
    { "type": "text", "id": "pass_label", "label": "Field label (screen readers)", "default": "Store password" },
    { "type": "text", "id": "pass_placeholder", "label": "Placeholder", "default": "Password" },
    { "type": "text", "id": "pass_button", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "pass_error", "label": "Wrong password message", "default": "That password didn't work. Try again." }
  ]
}
{% endschema %}
