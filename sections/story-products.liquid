{{ 'shop.css' | asset_url | stylesheet_tag }}
{{ 'story.css' | asset_url | stylesheet_tag }}

<section class="shop-grid story-shop" aria-labelledby="scent-title-{{ section.id }}">
  <header class="section-head" data-reveal>
    <h2 class="display-l" id="scent-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede }}</p>{%- endif -%}
  </header>
  <div class="holders__grid shop-grid__list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign card_url = block.settings.url | default: '#'
        assign card_name = block.settings.name
        if product != blank
          assign card_url = product.url
          if card_name == blank
            assign card_name = product.title
          endif
        endif
        case block.settings.gleam
          when 'yoga'
            assign fallback = 'shop-yoga.webp'
            assign fw = 821
          when 'duo'
            assign fallback = 'shop-duo.webp'
            assign fw = 879
          else
            assign fallback = 'shop-bonfire.webp'
            assign fw = 879
        endcase
      -%}
      <article class="holder-card gleam gleam--{{ block.settings.gleam }} gleam--light" data-reveal{% unless forloop.first %} style="--d: {{ forloop.index0 }}"{% endunless %} {{ block.shopify_attributes }}>
        <a class="holder-card__media" href="{{ card_url }}" aria-label="{{ block.settings.button_label | escape }}">
          {% render 'ms-image', image: block.settings.image, fallback: fallback, alt: block.settings.image_alt, width: fw, height: 1100, sizes: '(max-width: 900px) 82vw, 33vw' %}
        </a>
        <div class="holder-card__body">
          <div class="holder-card__info">
            <div>
              <h3 class="product-name">{{ card_name }}</h3>
              {%- if block.settings.desc != blank -%}<p class="product-desc product-desc--md">{{ block.settings.desc }}</p>{%- endif -%}
            </div>
            <p class="product-price">
              {%- if product != blank -%}
                {%- if product.price_varies -%}From {% endif -%}{{ product.price | money_without_trailing_zeros }}
              {%- else -%}
                {{ block.settings.price }}
              {%- endif -%}
            </p>
          </div>
          <div class="shop-card__actions">
            <a class="btn btn--solid btn--sm" href="{{ card_url }}">{{ block.settings.button_label }}</a>
            {%- if product != blank -%}
              {%- if product.available -%}
                <button class="icon-btn icon-btn--tile icon-btn--tile-light" type="button" aria-label="{{ block.settings.cart_label | escape }}" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">
                  {% render 'icon', name: 'cart-ink.svg', size: 16 %}
                </button>
              {%- else -%}
                <button class="icon-btn icon-btn--tile icon-btn--tile-light" type="button" aria-label="{{ 'products.sold_out' | t }}: {{ card_name | escape }}" disabled>
                  {% render 'icon', name: 'cart-ink.svg', size: 16 %}
                </button>
              {%- endif -%}
            {%- else -%}
              <button class="icon-btn icon-btn--tile icon-btn--tile-light" type="button" aria-label="{{ block.settings.cart_label | escape }}">
                {% render 'icon', name: 'cart-ink.svg', size: 16 %}
              </button>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Story scent grid",
  "class": "section-story-products",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FIND YOUR KIND OF SCENT." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Two distinct scents. Two different moods. One good reason to make room for both." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "name", "label": "Display name", "info": "Leave blank to use the product title", "default": "Bonfire · Agarwood" },
        { "type": "text", "id": "desc", "label": "Note", "default": "Dark resin + smoke" },
        { "type": "text", "id": "price", "label": "Price (used until a product is picked)", "default": "$24" },
        { "type": "url", "id": "url", "label": "Link (used until a product is picked)" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Meet Bonfire" },
        { "type": "text", "id": "cart_label", "label": "Cart button label (screen readers)", "default": "Add Bonfire to cart" },
        { "type": "header", "content": "Image" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Bonfire Agarwood incense box on grey" },
        {
          "type": "select",
          "id": "gleam",
          "label": "Style",
          "info": "Hover glow colour and bundled photo",
          "default": "bonfire",
          "options": [
            { "value": "bonfire", "label": "Bonfire" },
            { "value": "yoga", "label": "Yoga Studio" },
            { "value": "duo", "label": "Duo" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story scent grid",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "name": "Yoga Studio · Palo Santo Incense", "desc": "Warm resin + citrus peel", "button_label": "Meet Yoga Studio", "cart_label": "Add Yoga Studio to cart", "image_alt": "Yoga Studio Palo Santo incense box on grey", "gleam": "yoga" } },
        { "type": "card", "settings": { "name": "The Duo Bundle", "desc": "Both scents · In stock", "price": "$42", "button_label": "Meet the Duo", "cart_label": "Add the Duo to cart", "image_alt": "Yoga Studio and Bonfire boxes standing side by side", "gleam": "duo" } }
      ]
    }
  ]
}
{% endschema %}
