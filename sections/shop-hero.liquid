{{ 'shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank and collection
    assign heading = collection.title | upcase
  endif
  assign title_id = 'shop-title-' | append: section.id
-%}
<section class="shop-hero" aria-labelledby="{{ title_id }}">
  <div class="shop-hero__frame">
    {% render 'ms-image',
      image: section.settings.image,
      fallback: 'shop-hero.webp',
      alt: section.settings.image_alt,
      width: 1440,
      height: 2576,
      class: 'shop-hero__img',
      loading: 'eager',
      attrs: 'fetchpriority="high" data-parallax="0.1"'
    %}
    <h1 class="display-xl shop-hero__title" id="{{ title_id }}" data-split>{{ heading | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="shop-hero__sub" data-reveal style="--d: 4">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman with eyes closed breathing in smoke from an incense stick"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title.",
      "default": "INCENSE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Two scents. Find your favorite."
    }
  ],
  "presets": [
    {
      "name": "Shop hero"
    }
  ]
}
{% endschema %}
