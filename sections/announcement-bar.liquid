{%- if section.settings.text != blank -%}
<div class="announcement{% if template.name != 'index' %} announcement--tint{% endif %}" role="region" aria-label="{{ 'general.announcement' | t }}">
  <p>{%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}</p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "FREE US SHIPPING ON ORDERS OVER $50" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
