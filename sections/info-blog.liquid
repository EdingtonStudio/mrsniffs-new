{{ 'info.css' | asset_url | stylesheet_tag }}
<header class="info-hero">
  <div class="info-hero__inner" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="info-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="display-l">{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede }}</p>{%- endif -%}
  </div>
</header>
{%- paginate blog.articles by section.settings.per_page -%}
  <div class="info-blog">
    {%- if blog.articles.size > 0 -%}
      <ul class="info-blog__list">
        {%- for article in blog.articles -%}
          <li class="info-blog__item">
            <a class="info-blog__link" href="{{ article.url }}">
              {%- if article.image and section.settings.show_images -%}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'info-blog__img', widths: '400, 800, 1200', sizes: '(max-width: 900px) 100vw, 50vw', alt: article.image.alt | default: article.title }}
              {%- endif -%}
              <p class="info-hero__meta">{{ article.published_at | time_tag: '%B %-d, %Y' }}</p>
              <h2 class="display-s">{{ article.title }}</h2>
              {%- if article.excerpt != blank -%}<div class="info-blog__excerpt">{{ article.excerpt | strip_html | truncatewords: 30 }}</div>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="lede">{{ section.settings.empty_text }}</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="ms-pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ section.settings.prev_label }}</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ section.settings.next_label }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the blog title." },
    { "type": "text", "id": "lede", "label": "Intro" },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 4, "max": 24, "step": 2, "default": 12 },
    { "type": "checkbox", "id": "show_images", "label": "Show featured images", "default": true },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "Nothing here yet. Check back soon." },
    { "type": "text", "id": "prev_label", "label": "Previous label", "default": "Newer" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Older" }
  ]
}
{% endschema %}
