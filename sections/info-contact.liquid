{{ 'info.css' | asset_url | stylesheet_tag }}
<script src="{{ 'info.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign fid = 'ContactForm-' | append: section.id
-%}
<div class="contact">
  <div class="contact__aside">
    <div class="contact__block">
      {%- if s.email_label != blank -%}<p class="info-side__label">{{ s.email_label }}</p>{%- endif -%}
      {%- if s.email != blank -%}<p><a class="contact__email" href="mailto:{{ s.email | escape }}">{{ s.email }}</a></p>{%- endif -%}
      {%- if s.reply_note != blank -%}<p class="contact__fine">{{ s.reply_note }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="contact__block">
        {%- if s.links_label != blank -%}<p class="info-side__label">{{ s.links_label }}</p>{%- endif -%}
        <ul class="contact__links">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
  {%- form 'contact', id: fid, class: 'contact-form', data-contact: '', data-error: s.error_text, novalidate: 'novalidate' -%}
    {%- liquid
      assign err_name = false
      assign err_email = false
      assign err_body = false
      if form.errors
        for field in form.errors
          case field
            when 'name'
              assign err_name = true
            when 'email'
              assign err_email = true
            when 'body'
              assign err_body = true
          endcase
        endfor
      endif
    -%}
    <div class="field{% if err_name %} is-invalid{% endif %}">
      <label for="c-name">{{ s.name_label }}</label>
      <input id="c-name" name="contact[name]" type="text" autocomplete="name" value="{{ form.name | escape }}" required data-field="name">
    </div>
    <div class="field{% if err_email %} is-invalid{% endif %}">
      <label for="c-email">{{ s.email_field_label }}</label>
      <input id="c-email" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required data-field="email">
    </div>
    {%- if s.show_order -%}
      <div class="field">
        <label for="c-order">{{ s.order_label }}{% if s.order_hint != blank %} <span>{{ s.order_hint }}</span>{% endif %}</label>
        <input id="c-order" name="contact[order_number]" type="text" placeholder="{{ s.order_placeholder | escape }}">
      </div>
    {%- endif -%}
    {%- assign topics = s.topics | newline_to_br | split: '<br />' -%}
    {%- if s.topics != blank -%}
      <div class="field">
        <label for="c-topic">{{ s.topic_label }}</label>
        <select id="c-topic" name="contact[topic]">
          {%- for t in topics -%}
            {%- assign t = t | strip -%}
            {%- if t != blank -%}<option>{{ t }}</option>{%- endif -%}
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
    <div class="field field--full{% if err_body %} is-invalid{% endif %}">
      <label for="c-msg">{{ s.message_label }}</label>
      <textarea id="c-msg" name="contact[body]" rows="6" required data-field="message">{{ form.body }}</textarea>
    </div>
    <div class="field--full contact-form__foot">
      <button class="btn btn--solid" type="submit">{{ s.button_label }}</button>
      <p class="form-msg{% if form.posted_successfully? %} is-success{% elsif form.errors %} is-error{% endif %}" data-contact-msg role="status">
        {%- if form.posted_successfully? -%}
          {{ s.success_text }}
        {%- elsif form.errors -%}
          {%- for field in form.errors -%}
            {%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{%- endif -%}{%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </p>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "header", "content": "Email" },
    { "type": "text", "id": "email_label", "label": "Label", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email address", "default": "hello@mrsniffs.co" },
    { "type": "text", "id": "reply_note", "label": "Reply time", "default": "We reply within 1–3 business days." },
    { "type": "header", "content": "Quick answers" },
    { "type": "text", "id": "links_label", "label": "Label", "default": "Quick answers" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "email_field_label", "label": "Email label", "default": "Email" },
    { "type": "checkbox", "id": "show_order", "label": "Show order number field", "default": true },
    { "type": "text", "id": "order_label", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "order_hint", "label": "Order number hint", "default": "(optional)" },
    { "type": "text", "id": "order_placeholder", "label": "Order number placeholder", "default": "#1001" },
    { "type": "text", "id": "topic_label", "label": "Topic label", "default": "What's it about?" },
    { "type": "textarea", "id": "topics", "label": "Topic options", "info": "One per line. Leave blank to hide the field.", "default": "An order\nScents and products\nWholesale or collabs\nSomething else" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "error_text", "label": "Validation message", "default": "Add your name, a valid email and a message, then send again." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Message sent. We’ll get back to you within 1–3 business days." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "FAQ" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
