<section class="faq" id="faq" aria-labelledby="faq-title">
  {%- if section.settings.show_mascot -%}
    <img class="faq__mascot" src="{{ 'mascot.svg' | asset_url }}" width="494" height="536" alt="" aria-hidden="true" loading="lazy">
  {%- endif -%}
  <div class="faq__inner">
    <h2 class="display-l" id="faq-title" data-reveal>{{ section.settings.heading }}</h2>

    <div class="accordion" data-reveal style="--d: 1">
      {%- for block in section.blocks -%}
        <details class="accordion__item" data-accordion {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><img src="{{ 'plus.svg' | asset_url }}" width="18" height="18" alt=""></summary>
          <div class="accordion__panel">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    <div class="btn-row" data-reveal style="--d: 2">
      {%- if section.settings.button_1_label != blank -%}
        <a class="btn btn--solid btn--w165" href="{{ section.settings.button_1_url | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="btn btn--outline" href="{{ section.settings.button_2_url | default: '#' }}">{{ section.settings.button_2_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home: FAQ",
  "class": "section-home-faq",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "BEFORE YOU LIGHT ONE" },
    { "type": "checkbox", "id": "show_mascot", "label": "Show mascot illustration", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop incense" },
    { "type": "url", "id": "button_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Find your scent" },
    { "type": "url", "id": "button_2_url", "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do I need a holder?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Burn incense in a stable, heat-resistant holder that catches falling ash.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home: FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "How many sticks come in a pack?", "answer": "<p>About 50 sticks per box (25 g).</p>" } }
      ]
    }
  ]
}
{% endschema %}
