{{ 'shop.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Compare table. Columns = up to 3 products (section settings), rows = blocks.
  A column is shown when it has a product or a header name.
{%- endcomment -%}
{%- liquid
  assign title_id = 'compare-title-' | append: section.id
  assign col_ids = '1,2,3' | split: ','
-%}
<section class="compare" id="compare" aria-labelledby="{{ title_id }}">
  <header class="section-head" data-reveal>
    <h2 class="display-l" id="{{ title_id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.lede != blank -%}
      <p class="lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}
  </header>

  <div class="compare__scroll" data-reveal style="--d: 1">
    <table class="compare__table">
      <caption class="sr-only">{{ section.settings.caption | escape }}</caption>
      <thead>
        <tr>
          <td class="compare__corner"></td>
          {%- for c in col_ids -%}
            {%- liquid
              assign key_product = 'col_' | append: c | append: '_product'
              assign key_name = 'col_' | append: c | append: '_name'
              assign key_icon = 'col_' | append: c | append: '_icon'
              assign key_tint = 'col_' | append: c | append: '_tint'
              assign p = section.settings[key_product]
              assign name = section.settings[key_name]
              if name == blank and p != blank
                assign name = p.title
              endif
              if name == blank
                continue
              endif
              assign icon = section.settings[key_icon]
            -%}
            <th scope="col" class="compare__head compare__head--{{ section.settings[key_tint] }}"><span>
              {%- case icon -%}
                {%- when 'cmp-flame.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="13" height="16" alt="">
                {%- when 'cmp-lotus.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="16" height="13" alt="">
                {%- when 'cmp-scent.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="16" height="16" alt="">
                {%- when 'cmp-pack.svg' -%}<img src="{{ icon | asset_url }}" width="16" height="15" alt="">
                {%- when 'none' -%}
                {%- else -%}<img src="{{ icon | asset_url }}" width="16" height="16" alt="">
              {%- endcase -%}
              {{- name | escape -}}
            </span></th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- assign icon = block.settings.icon -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row"><span>
              {%- case icon -%}
                {%- when 'cmp-flame.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="13" height="16" alt="">
                {%- when 'cmp-lotus.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="16" height="13" alt="">
                {%- when 'cmp-scent.svg' -%}<img class="is-flipped" src="{{ icon | asset_url }}" width="16" height="16" alt="">
                {%- when 'cmp-pack.svg' -%}<img src="{{ icon | asset_url }}" width="16" height="15" alt="">
                {%- when 'none' -%}
                {%- else -%}<img src="{{ icon | asset_url }}" width="16" height="16" alt="">
              {%- endcase -%}
              {{- block.settings.label | escape -}}
            </span></th>
            {%- for c in col_ids -%}
              {%- liquid
                assign key_product = 'col_' | append: c | append: '_product'
                assign key_name = 'col_' | append: c | append: '_name'
                assign key_cell = 'cell_' | append: c
                assign p = section.settings[key_product]
                if section.settings[key_name] == blank and p == blank
                  continue
                endif
              -%}
              <td>
                {%- if block.settings.row_type == 'price' and p != blank -%}
                  {%- if p.price_varies -%}{{ section.settings.price_from | escape }} {% endif -%}
                  {{- p.price | money_without_trailing_zeros -}}
                {%- else -%}
                  {{- block.settings[key_cell] | escape -}}
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td class="compare__corner"></td>
          {%- for c in col_ids -%}
            {%- liquid
              assign key_product = 'col_' | append: c | append: '_product'
              assign key_name = 'col_' | append: c | append: '_name'
              assign key_action = 'col_' | append: c | append: '_action'
              assign key_label = 'col_' | append: c | append: '_button_label'
              assign key_link = 'col_' | append: c | append: '_link'
              assign p = section.settings[key_product]
              if section.settings[key_name] == blank and p == blank
                continue
              endif
              assign label = section.settings[key_label]
              assign link = section.settings[key_link] | default: '#'
              if p != blank
                assign link = p.url
              endif
            -%}
            <td>
              {%- if section.settings[key_action] == 'link' -%}
                <a class="btn btn--solid btn--sm btn--block" href="{{ link }}">{{ label | escape }}</a>
              {%- elsif p != blank and p.available == false -%}
                <button class="btn btn--solid btn--sm btn--block" type="button" disabled>{{ section.settings.sold_out_label | escape }}</button>
              {%- else -%}
                <button class="btn btn--solid btn--sm btn--block" type="button"{% if p != blank %} data-add-to-cart="{{ p.selected_or_first_available_variant.id }}"{% endif %}>{{ label | escape }}</button>
              {%- endif -%}
            </td>
          {%- endfor -%}
        </tr>
      </tfoot>
    </table>
  </div>
</section>

