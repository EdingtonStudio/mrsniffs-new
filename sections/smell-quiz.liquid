{{ 'smell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smell.js' | asset_url }}" defer></script>
{%- comment -%}
  The quiz is driven by assets/smell.js from these data attributes:
  each answer's data-lean (bonfire / yoga / both) scores a result; the highest
  score wins and a tie shows the result named in data-tie.
{%- endcomment -%}
<section class="st" id="smell-test" aria-label="{{ section.settings.aria_label | escape }}" data-smell-test data-tie="duo" data-count-text="{{ section.settings.count_text | escape }}">
  <div class="st__inner">
    <div class="st__bar" data-st-bar>
      <button class="st__back" type="button" data-st-back hidden>{{ section.settings.back_label }}</button>
      <p class="st__count" data-st-count aria-live="polite">{%- assign total = section.blocks.size | append: '' -%}{{ section.settings.count_text | replace: '[n]', '1' | replace: '[total]', total }}</p>
      <div class="st__progress" aria-hidden="true"><span data-st-fill></span></div>
    </div>
    {%- assign answer_letters = 'a,b,c,d' | split: ',' -%}
    {%- assign result_keys = 'bonfire,yoga,duo' | split: ',' -%}
    {%- for block in section.blocks -%}
      <fieldset class="st-q" data-step="{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
        <legend class="display-l st-q__title">{{ block.settings.title }}</legend>
        <div class="st-opts">
          {%- assign key_index = 0 -%}
          {%- for letter in answer_letters -%}
            {%- capture label_id -%}{{ letter }}_label{%- endcapture -%}
            {%- capture sub_id -%}{{ letter }}_sub{%- endcapture -%}
            {%- capture lean_id -%}{{ letter }}_lean{%- endcapture -%}
            {%- if block.settings[label_id] != blank -%}
              {%- assign key = 'ABCD' | slice: key_index -%}
              {%- assign key_index = key_index | plus: 1 -%}
              <button class="st-opt" type="button" data-lean="{{ block.settings[lean_id] }}">
                <span class="st-opt__key">{{ key }}</span>
                <span class="st-opt__label">{{ block.settings[label_id] }}</span>
                {%- if block.settings[sub_id] != blank -%}<span class="st-opt__sub">{{ block.settings[sub_id] }}</span>{%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}

    {%- for key in result_keys -%}
      {%- liquid
        assign p_id = key | append: '_product'
        assign product = section.settings[p_id]
        if key == 'duo' and product == blank
          assign product = settings.duo_product
        endif
        assign img_id = key | append: '_image'
        assign alt_id = key | append: '_image_alt'
        assign title_id = key | append: '_title'
        assign line_id = key | append: '_line'
        assign text_id = key | append: '_text'
        assign price_id = key | append: '_price'
        assign link_label_id = key | append: '_link_label'
        assign link_id = key | append: '_link'
        assign link = section.settings[link_id] | default: '#'
        assign price = section.settings[price_id]
        if product != blank
          assign link = product.url
          assign price = product.price | money_without_trailing_zeros
          if product.price_varies
            assign price = 'From ' | append: price
          endif
        endif
        case key
          when 'bonfire'
            assign tint = 'var(--c-tint-bonfire)'
            assign fallback = 'shop-bonfire.webp'
            assign fw = 879
          when 'yoga'
            assign tint = 'var(--c-tint-yoga)'
            assign fallback = 'shop-yoga.webp'
            assign fw = 821
          else
            assign tint = 'var(--c-stone)'
            assign fallback = 'shop-duo.webp'
            assign fw = 879
        endcase
      -%}
      <div class="st-result st-result--{{ key }}" data-result="{{ key }}" hidden>
        <div class="st-result__media" style="--tint: {{ tint }}">
          {% render 'ms-image', image: section.settings[img_id], fallback: fallback, alt: section.settings[alt_id], width: fw, height: 1100, sizes: '(max-width: 900px) 100vw, 45vw' %}
        </div>
        <div class="st-result__copy">
          {%- if section.settings.result_eyebrow != blank -%}<p class="st-result__eyebrow">{{ section.settings.result_eyebrow }}</p>{%- endif -%}
          <h2 class="display-xl">{{ section.settings[title_id] }}</h2>
          {%- if section.settings[line_id] != blank -%}<p class="st-result__line">{{ section.settings[line_id] }}</p>{%- endif -%}
          {%- if section.settings[text_id] != blank -%}<p class="lede">{{ section.settings[text_id] }}</p>{%- endif -%}
          <div class="btn-row">
            {%- if product != blank -%}
              {%- if product.available -%}
                <button class="btn btn--solid" type="button" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">{{ section.settings.add_label }} · {{ price }}</button>
              {%- else -%}
                <button class="btn btn--solid" type="button" disabled aria-disabled="true">{{ 'products.sold_out' | t }}</button>
              {%- endif -%}
            {%- else -%}
              <button class="btn btn--solid" type="button">{{ section.settings.add_label }} · {{ price }}</button>
            {%- endif -%}
            {%- if section.settings[link_label_id] != blank -%}
              <a class="btn btn--outline" href="{{ link }}">{{ section.settings[link_label_id] }}</a>
            {%- endif -%}
          </div>
          <button class="text-link st-retake" type="button" data-retake><span>{{ section.settings.retake_label }}</span></button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

