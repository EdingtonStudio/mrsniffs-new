{{ 'shop.css' | asset_url | stylesheet_tag }}
{%- assign title_id = 'search-title-' | append: section.id -%}
<section class="ms-page shop-search" aria-labelledby="{{ title_id }}">
  <div class="ms-page__wide">
    <header class="section-head shop-search__head">
      <h1 class="display-l" id="{{ title_id }}">{{ section.settings.heading | escape }}</h1>
      {%- if search.performed -%}
        <p class="lede" role="status">
          {%- if search.results_count > 0 -%}
            {{ section.settings.results_text | replace: '[count]', search.results_count | replace: '[terms]', search.terms | escape }}
          {%- else -%}
            {{ section.settings.empty_text | replace: '[terms]', search.terms | escape }}
          {%- endif -%}
        </p>
      {%- elsif section.settings.intro != blank -%}
        <p class="lede">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <form class="shop-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="SearchPage-{{ section.id }}">{{ section.settings.input_label | escape }}</label>
      <input class="shop-search__input" id="SearchPage-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn--solid" type="submit">{{ section.settings.submit_label | escape }}</button>
    </form>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        {%- liquid
          assign product_results = search.results | where: 'object_type', 'product'
          assign article_results = search.results | where: 'object_type', 'article'
          assign page_results = search.results | where: 'object_type', 'page'
          assign other_results = article_results | concat: page_results
        -%}
        {%- if product_results.size > 0 -%}
          <div class="holders__grid shop-grid__list shop-search__grid">
            {%- for product in product_results -%}
              {%- liquid
                assign short = product.metafields.custom.short_name.value | default: product.title
                assign note = product.metafields.custom.card_note.value | default: product.type
                assign gleam = ''
                if product.tags contains 'gleam-bonfire'
                  assign gleam = ' gleam--bonfire'
                elsif product.tags contains 'gleam-yoga'
                  assign gleam = ' gleam--yoga'
                elsif product.tags contains 'gleam-duo'
                  assign gleam = ' gleam--duo'
                endif
                assign d = forloop.index0 | modulo: 3
                assign meet = section.settings.meet_label | replace: '[name]', short
                assign add_label = section.settings.add_label | replace: '[name]', short
                assign img_alt = product.featured_image.alt | default: product.title
              -%}
              <article class="holder-card gleam{{ gleam }} gleam--light" data-reveal{% if d > 0 %} style="--d: {{ d }}"{% endif %}>
                <a class="holder-card__media" href="{{ product.url }}" aria-label="{{ meet | escape }}">
                  {% render 'ms-image',
                    image: product.featured_image,
                    fallback: 'shop-bonfire.webp',
                    alt: img_alt,
                    width: 879,
                    height: 1100,
                    sizes: '(max-width: 900px) 82vw, 33vw',
                    loading: 'lazy'
                  %}
                </a>
                <div class="holder-card__body">
                  <div class="holder-card__info">
                    <div>
                      <h2 class="product-name">{{ product.title | escape }}</h2>
                      {%- if note != blank -%}
                        <p class="product-desc product-desc--md">{{ note | escape }}</p>
                      {%- endif -%}
                    </div>
                    <p class="product-price">
                      {%- if product.price_varies -%}{{ section.settings.price_from | escape }} {% endif -%}
                      {{- product.price | money_without_trailing_zeros -}}
                    </p>
                  </div>
                  <div class="shop-card__actions">
                    <a class="btn btn--solid btn--sm" href="{{ product.url }}">{{ meet | escape }}</a>
                    {%- if product.available -%}
                      <button class="icon-btn icon-btn--tile icon-btn--tile-light" type="button" aria-label="{{ add_label | escape }}" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">
                        {% render 'icon', name: 'cart-ink.svg', size: 16 %}
                      </button>
                    {%- else -%}
                      <button class="icon-btn icon-btn--tile icon-btn--tile-light" type="button" aria-label="{{ section.settings.sold_out_label | escape }}" disabled>
                        {% render 'icon', name: 'cart-ink.svg', size: 16 %}
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if other_results.size > 0 -%}
          <ul class="shop-search__list">
            {%- for item in other_results -%}
              <li class="shop-search__item">
                <p class="shop-search__type">
                  {%- if item.object_type == 'article' -%}{{ section.settings.article_label | escape }}{%- else -%}{{ section.settings.page_label | escape }}{%- endif -%}
                </p>
                <a class="shop-search__link" href="{{ item.url }}">{{ item.title | escape }}</a>
                {%- assign excerpt = item.excerpt | default: item.content | strip_html | truncatewords: 30 -%}
                {%- if excerpt != blank -%}
                  <p class="shop-search__excerpt">{{ excerpt }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="ms-pagination" aria-label="{{ section.settings.pagination_label | escape }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ section.settings.prev_label | escape }}</a>{%- endif -%}
            <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- elsif search.performed -%}
      <div class="cart-empty shop-search__empty">
        {% render 'icon', name: 'search-ink.svg', size: 40, class: 'cart-empty__icon' %}
        <div class="cart-empty__actions">
          {%- if section.settings.empty_button_label != blank -%}
            <a class="btn btn--solid" href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.empty_button_2_label != blank and section.settings.empty_button_2_link != blank -%}
            <a class="btn btn--outline" href="{{ section.settings.empty_button_2_link }}">{{ section.settings.empty_button_2_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEARCH"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro (before searching)",
      "default": "Search scents, holders, help."
    },
    {
      "type": "text",
      "id": "results_text",
      "label": "Results text",
      "info": "[count] and [terms] are replaced.",
      "default": "[count] results for “[terms]”"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "No results text",
      "info": "[terms] is replaced.",
      "default": "Nothing matches “[terms]”. Try a scent name, “holder” or “shipping”."
    },
    {
      "type": "header",
      "content": "Search form"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label (screen readers)",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Search scents, holders, help"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Button label",
      "default": "Search"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "text",
      "id": "meet_label",
      "label": "Card button label",
      "info": "[name] is replaced by the product's short name (metafield custom.short_name, else title).",
      "default": "Meet [name]"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart accessible label",
      "default": "Add [name] to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "price_from",
      "label": "Price prefix when variants vary",
      "default": "From"
    },
    {
      "type": "header",
      "content": "Pages and articles"
    },
    {
      "type": "text",
      "id": "page_label",
      "label": "Page label",
      "default": "Page"
    },
    {
      "type": "text",
      "id": "article_label",
      "label": "Article label",
      "default": "Journal"
    },
    {
      "type": "header",
      "content": "No results"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop incense"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "empty_button_2_label",
      "label": "Second button label",
      "default": "Find your scent"
    },
    {
      "type": "url",
      "id": "empty_button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "text",
      "id": "pagination_label",
      "label": "Pagination accessible label",
      "default": "Pagination"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous page label",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next page label",
      "default": "Next"
    }
  ]
}
{% endschema %}
