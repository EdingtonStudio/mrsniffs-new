{{ 'howto.css' | asset_url | stylesheet_tag }}

<section class="burn section--ink"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' | strip | escape }}"{% endif %} aria-labelledby="burn-title-{{ section.id }}" data-burn style="--steps: {{ section.blocks.size | at_least: 1 }}">
  <div class="burn__track">
    <div class="burn__stage">
      <header class="section-head burn__head">
        <h2 class="display-l" id="burn-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}<p class="lede lede--on-ink">{{ section.settings.lede }}</p>{%- endif -%}
      </header>

      <div class="burn__body">
        <ol class="burn__steps" aria-label="{{ section.settings.steps_label | escape }}">
          {%- for block in section.blocks -%}
            <li><button type="button" class="burn__step" data-i="{{ forloop.index0 }}">{{ block.settings.label }}</button></li>
          {%- endfor -%}
        </ol>

        <div class="burn__frames">
          {%- for block in section.blocks -%}
            {%- liquid
              case block.settings.fallback
                when 'howto-burn-catch.webp'
                  assign fw = 1400
                  assign fh = 788
                when 'howto-burn-out.webp'
                  assign fw = 880
                  assign fh = 1100
                else
                  assign fw = 1100
                  assign fh = 619
              endcase
            -%}
            <figure class="burn__frame" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {% render 'ms-image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.image_alt, width: fw, height: fh, sizes: '(max-width: 900px) 100vw, 600px' %}
              <figcaption class="burn__cap"><strong>{{ block.settings.label }}</strong>{{ block.settings.text }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>

        <div class="burn__descs" aria-live="polite">
          {%- for block in section.blocks -%}
            <p class="burn__desc" data-i="{{ forloop.index0 }}">{{ block.settings.text }}</p>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How-to burn steps",
  "class": "section-howto-burn",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section ID", "info": "Used by the guide tabs in the hero", "default": "use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW TO BURN INCENSE" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Follow these simple steps to light, enjoy, and safely extinguish your incense." },
    { "type": "text", "id": "steps_label", "label": "Steps list label (screen readers)", "default": "Steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Step name", "default": "Light" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Light the incense tip." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback",
          "label": "Bundled photo",
          "info": "Shown when no image is picked",
          "default": "howto-burn-light.webp",
          "options": [
            { "value": "howto-burn-light.webp", "label": "Stick in holder" },
            { "value": "howto-burn-catch.webp", "label": "Match lighting the tip" },
            { "value": "howto-burn-place.webp", "label": "Smoking stick in holder" },
            { "value": "howto-burn-out.webp", "label": "Last wisp of smoke" }
          ]
        },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Incense stick resting in a black holder" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How-to burn steps",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "label": "Let it catch", "text": "Let the tip burn, then blow out the flame. Ensure it glows and releases a steady stream of smoke.", "fallback": "howto-burn-catch.webp", "image_alt": "A match lighting the tip of an incense stick" } },
        { "type": "step", "settings": { "label": "Place in the holder", "text": "Rest securely in holder.", "fallback": "howto-burn-place.webp", "image_alt": "Smoking incense stick placed in a black holder" } },
        { "type": "step", "settings": { "label": "Put it out", "text": "Extinguish completely after use.", "fallback": "howto-burn-out.webp", "image_alt": "Last wisp of smoke rising from a holder" } }
      ]
    }
  ]
}
{% endschema %}
