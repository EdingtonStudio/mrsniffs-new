{{ 'info.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign anchor = section.settings.anchor | default: section.settings.heading | handleize
  if anchor == blank
    assign anchor = section.id
  endif
-%}
<section class="faq-group" id="{{ anchor | escape }}" data-faq-group>
  <h2 class="display-s">{{ section.settings.heading }}</h2>
  <div class="accordion">
    {%- for block in section.blocks -%}
      <details class="accordion__item" data-accordion {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question }}</span><img src="{{ 'plus.svg' | asset_url }}" width="18" height="18" alt=""></summary>
        <div class="accordion__panel">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ topic",
  "class": "ms-faq-topic",
  "settings": [
    { "type": "text", "id": "heading", "label": "Topic heading", "default": "Scents and sticks" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Used for links like /pages/faq#scents. Lowercase, no spaces. Leave blank to build it from the heading." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What are the sticks made of?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Aromatic wood powder, a natural bark binder and water. No synthetic fragrance, no added perfume and no dyes. There's no bamboo core; it's wood all the way through.</p>" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "FAQ topic", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
