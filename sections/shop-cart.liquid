{{ 'shop.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Full cart page (/cart). A plain Shopify cart form: works without JavaScript.
  Quantities post as updates[], remove uses item.url_to_remove, checkout posts name="checkout".
{%- endcomment -%}
{%- assign title_id = 'cart-page-title-' | append: section.id -%}
<section class="ms-page shop-cart" aria-labelledby="{{ title_id }}">
  <div class="ms-page__wide">
    <header class="section-head shop-cart__head">
      <h1 class="display-l" id="{{ title_id }}">{{ section.settings.heading | escape }}{% if cart.item_count > 0 %} <span class="cart__count">({{ cart.item_count }})</span>{% endif %}</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <form class="shop-cart__form" action="{{ routes.cart_url }}" method="post" id="cart-page-form" novalidate>
        <div class="shop-cart__grid">
          <div class="shop-cart__lines">
            <ul class="cart__lines">
              {%- for item in cart.items -%}
                {%- liquid
                  assign note = ''
                  unless item.product.has_only_default_variant
                    assign note = item.variant.title
                  endunless
                  if item.selling_plan_allocation
                    if note != blank
                      assign note = note | append: ' · '
                    endif
                    assign note = note | append: item.selling_plan_allocation.selling_plan.name
                  endif
                  assign qty_label = section.settings.qty_label | replace: '[name]', item.product.title
                -%}
                <li class="cart-line">
                  <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 240 }}" srcset="{{ item.image | image_url: width: 168 }} 1x, {{ item.image | image_url: width: 336 }} 2x" width="84" height="104" alt="" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="cart-line__info">
                    <div class="cart-line__top">
                      <a class="cart-line__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      <span class="cart-line__price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <s class="shop-cart__was">{{ item.original_line_price | money }}</s>
                        {% endif -%}
                        {{- item.final_line_price | money -}}
                      </span>
                    </div>
                    {%- if note != blank -%}
                      <p class="cart-line__note">{{ note | escape }}</p>
                    {%- endif -%}
                    {%- for property in item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and first_char != '_' -%}
                        <p class="cart-line__note">{{ property.first | escape }}: {{ property.last | escape }}</p>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <p class="cart-line__note shop-cart__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
                    {%- endfor -%}
                    <div class="cart-line__actions">
                      <div class="cart-qty shop-cart__qty">
                        <label class="sr-only" for="CartQty-{{ item.key | handleize }}">{{ qty_label | escape }}</label>
                        <input id="CartQty-{{ item.key | handleize }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-page-qty>
                      </div>
                      <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ section.settings.remove_label | escape }}</a>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
            <button class="btn btn--outline btn--sm shop-cart__update" type="submit" name="update">{{ section.settings.update_label | escape }}</button>
          </div>

          <aside class="shop-cart__summary" aria-label="{{ section.settings.summary_label | escape }}">
            {%- liquid
              assign threshold = settings.free_shipping_threshold | times: 100
              assign subtotal = cart.items_subtotal_price
            -%}
            {%- if threshold > 0 -%}
              {%- liquid
                assign left = threshold | minus: subtotal
                assign pct = subtotal | times: 100 | divided_by: threshold
                if pct > 100
                  assign pct = 100
                endif
              -%}
              <div class="cart-ship">
                <p class="cart-ship__msg">
                  {%- if left > 0 -%}
                    {%- capture left_money -%}<strong>{{ left | money }}</strong>{%- endcapture -%}
                    {{ section.settings.ship_away | escape | replace: '[amount]', left_money }}
                  {%- else -%}
                    {{ section.settings.ship_unlocked | escape }}
                  {%- endif -%}
                </p>
                <div class="cart-ship__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></div>
              </div>
            {%- endif -%}

            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart__row shop-cart__discount-row"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
            {%- endfor -%}

            <div class="cart__row"><span>{{ section.settings.subtotal_label | escape }}</span><span class="cart__subtotal">{{ cart.total_price | money }}</span></div>
            {%- if section.settings.fine_print != blank -%}
              <p class="cart__fine">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}

            {%- if section.settings.show_note -%}
              <div class="shop-cart__note">
                <label class="cart__fine" for="CartNote-{{ section.id }}">{{ section.settings.note_label | escape }}</label>
                <textarea id="CartNote-{{ section.id }}" name="note" rows="3">{{ cart.note | escape }}</textarea>
              </div>
            {%- endif -%}

            <button class="btn btn--solid btn--block cart__checkout" type="submit" name="checkout">{{ section.settings.checkout_label | escape }}</button>
            {%- if section.settings.continue_label != blank -%}
              <a class="text-link cart__continue" href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}"><span>{{ section.settings.continue_label | escape }}</span></a>
            {%- endif -%}
          </aside>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty shop-cart__empty">
        {% render 'icon', name: 'bag-ink.svg', size: 40, class: 'cart-empty__icon' %}
        <p class="display-s">{{ section.settings.empty_title | escape }}</p>
        {%- if section.settings.empty_text != blank -%}
          <p class="lede">{{ section.settings.empty_text | escape }}</p>
        {%- endif -%}
        <div class="cart-empty__actions">
          <a class="btn btn--solid" href="{{ section.settings.empty_shop_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_shop_label | escape }}</a>
          {%- if section.settings.empty_quiz_label != blank and section.settings.empty_quiz_link != blank -%}
            <a class="btn btn--outline" href="{{ section.settings.empty_quiz_link }}">{{ section.settings.empty_quiz_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  // Progressive enhancement: submit the cart form when a quantity changes.
  (function () {
    var form = document.getElementById('cart-page-form');
    if (!form) return;
    form.addEventListener('change', function (e) {
      if (e.target.matches('[data-cart-page-qty]')) form.requestSubmit ? form.requestSubmit(form.querySelector('[name="update"]')) : form.submit();
    });
  })();
</script>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOUR CART"
    },
    {
      "type": "header",
      "content": "Line items"
    },
    {
      "type": "text",
      "id": "qty_label",
      "label": "Quantity label (screen readers)",
      "info": "[name] is replaced by the product title.",
      "default": "Quantity for [name]"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update button label",
      "default": "Update cart"
    },
    {
      "type": "header",
      "content": "Summary"
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Summary label (screen readers)",
      "default": "Order summary"
    },
    {
      "type": "text",
      "id": "ship_away",
      "label": "Free shipping progress message",
      "info": "[amount] is replaced by the amount left. Uses the free shipping threshold in theme settings.",
      "default": "You're [amount] away from free shipping."
    },
    {
      "type": "text",
      "id": "ship_unlocked",
      "label": "Free shipping unlocked message",
      "default": "Free shipping unlocked."
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Shipping and taxes calculated at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show order note",
      "default": false
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Order note label",
      "default": "Order note"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Keep shopping label",
      "default": "Keep shopping"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "Keep shopping link"
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Title",
      "default": "Nothing to sniff here yet."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text",
      "default": "Your cart is empty. Start with a scent, or let the Smell Test pick one."
    },
    {
      "type": "text",
      "id": "empty_shop_label",
      "label": "Shop button label",
      "default": "Shop incense"
    },
    {
      "type": "url",
      "id": "empty_shop_link",
      "label": "Shop button link"
    },
    {
      "type": "text",
      "id": "empty_quiz_label",
      "label": "Second button label",
      "default": "Find your scent"
    },
    {
      "type": "url",
      "id": "empty_quiz_link",
      "label": "Second button link"
    }
  ]
}
{% endschema %}
