{{ 'info.css' | asset_url | stylesheet_tag }}
<section class="nf">
  {%- if section.settings.code != blank -%}<p class="nf__code" aria-hidden="true">{{ section.settings.code }}</p>{%- endif -%}
  <h1 class="display-l">{{ section.settings.heading }}</h1>
  {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede }}</p>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="btn-row">
      {%- for block in section.blocks -%}
        <a class="btn btn--{{ block.settings.style }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Not found",
  "settings": [
    { "type": "text", "id": "code", "label": "Big number", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page went up in smoke." },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "The link might be old, or the page moved. Let's get you somewhere that smells better." }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop incense" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Not found", "blocks": [{ "type": "button" }] }]
}
{% endschema %}
