{%- doc -%}
  Renders a merchant-picked image, or the bundled theme asset when none is picked.

  @param {object} [image] - image from an image_picker setting
  @param {string} fallback - theme asset filename used when no image is picked
  @param {string} [alt] - alt text (empty string for decorative images)
  @param {number} width - intrinsic width of the fallback asset
  @param {number} height - intrinsic height of the fallback asset
  @param {string} [class] - class attribute
  @param {string} [sizes] - sizes attribute (default 100vw)
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [attrs] - extra raw attributes, e.g. 'data-parallax="0.08" fetchpriority="high"'
{%- enddoc -%}
{%- liquid
  assign lazy = loading | default: 'lazy'
  assign alt_text = alt
  if image != blank and alt_text == blank
    assign alt_text = image.alt
  endif
-%}
{%- if image != blank -%}
  {%- assign w = width | default: image.width -%}
  {%- assign h = height | default: image.height -%}
  {%- if image.width > 0 -%}{%- assign h = image.height | times: w | divided_by: image.width -%}{%- endif -%}
  <img src="{{ image | image_url: width: 1600 }}" srcset="{{ image | image_url: width: 480 }} 480w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2400 }} 2400w" sizes="{{ sizes | default: '100vw' }}" width="{{ w }}" height="{{ h }}" alt="{{ alt_text | escape }}"{% if class != blank %} class="{{ class }}"{% endif %} loading="{{ lazy }}" {{ attrs }}>
{%- else -%}
  <img src="{{ fallback | asset_url }}" width="{{ width }}" height="{{ height }}" alt="{{ alt | escape }}"{% if class != blank %} class="{{ class }}"{% endif %} loading="{{ lazy }}" {{ attrs }}>
{%- endif -%}
