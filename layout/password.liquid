<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if request.design_mode %} class="shopify-design-mode"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- else -%}
    <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{ 'favicon-light.svg' | asset_url }}" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="{{ 'favicon-dark.svg' | asset_url }}" type="image/svg+xml" media="(prefers-color-scheme: dark)">
  {%- endif -%}
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  <title>{{ page_title | default: shop.name }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}

  {{ 'big-shoulders-display-latin-700-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
  {{ 'inter-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'main.css' | asset_url | stylesheet_tag }}
  {{ 'info.css' | asset_url | stylesheet_tag }}
  {{ 'theme-shopify.css' | asset_url | stylesheet_tag }}

  <script>
    window.MrSniffs = {
      routes: { root: {{ routes.root_url | json }} },
      klaviyo: { companyId: {{ settings.klaviyo_company_id | json }}, listId: {{ settings.klaviyo_list_id | json }} }
    };
  </script>
  <script src="{{ 'main.js' | asset_url }}" defer></script>
  <script src="{{ 'password.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="page-soon template-password">
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
