    "why": {
      "type": "home-why",
      "settings": {
        "eyebrow": "Why Mr. Sniff's",
        "heading": "NOTHING BUT WOOD.",
        "lede": "Most incense is a bamboo stick dipped in perfume. Ours is wood all the way through.",
        "caption": "Mr. Sniff's incense compared with typical stick incense",
        "ours_label": "Mr. Sniff's",
        "theirs_label": "Typical stick incense",
        "button_1_label": "Shop incense",
        "button_1_url": "/collections/shop",
        "button_2_label": "How to use incense",
        "button_2_url": "/pages/how-to-use"
      },
      "blocks": {
        "point_1": {
          "type": "point",
          "settings": {
            "icon": "pdp-i-materials.svg",
            "title": "All wood",
            "text": "Aromatic wood powder, a little odorless bark to hold it together, and water. That's the whole ingredient list."
          }
        },
        "point_2": {
          "type": "point",
          "settings": {
            "icon": "pdp-i-burn.svg",
            "title": "Nothing fake",
            "text": "No synthetic fragrance, no perfume dip, no dyes. The smell is the oil that was already in the wood."
          }
        },
        "point_3": {
          "type": "point",
          "settings": {
            "icon": "pdp-i-madein.svg",
            "title": "Nothing to hide",
            "text": "Pressed and sun-dried in Taiwan, the Japanese way. Our palo santo comes from trees that fell on their own."
          }
        },
        "row_1": {
          "type": "row",
          "settings": {
            "icon": "pdp-i-sticks.svg",
            "label": "Core",
            "ours": "Solid wood, end to end",
            "theirs": "Bamboo stick"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "icon": "cmp-scent.svg",
            "label": "Where the scent comes from",
            "ours": "Oils already in the wood",
            "theirs": "Fragrance oil dip"
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "icon": "pdp-i-burn.svg",
            "label": "Dyes",
            "ours": "None",
            "theirs": "Often, for color"
          }
        },
        "row_4": {
          "type": "row",
          "settings": {
            "icon": "pdp-i-materials.svg",
            "label": "Binder",
            "ours": "Odorless bark powder",
            "theirs": "Rarely listed"
          }
        },
        "row_5": {
          "type": "row",
          "settings": {
            "icon": "pdp-i-madein.svg",
            "label": "How it's made",
            "ours": "Extruded and sun-dried in Taiwan",
            "theirs": "Hand-dipped, origin rarely listed"
          }
        },
        "row_6": {
          "type": "row",
          "settings": {
            "icon": "cmp-pack.svg",
            "label": "Ingredient list",
            "ours": "On the box",
            "theirs": "Usually missing"
          }
        }
      },
      "block_order": [
        "point_1",
